**/vendor/
**/node_modules/

# Ignore sensitive environment files
**/.env
.env

# Ignore build artifacts and cache
**/public/hot
**/public/storage
**/storage/*.key
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*

