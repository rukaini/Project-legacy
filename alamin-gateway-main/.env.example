APP_NAME="ELIT Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public base URL assigned to this portal. Do not include a trailing slash.
APP_URL=
# Set only when HTTPS is terminated by an approved reverse proxy.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Canonical Al Amin database connection. Use a least-privilege account.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
# Must be different from every target application's cookie name.
SESSION_COOKIE=alamin_login_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=alamin_login_
# One-time codes and their locks must use this same store.
SSO_CACHE_STORE=file

SSO_CODE_TTL=90
# Secure default. Set false only for an explicitly approved HTTP deployment.
ALAMIN_LOGIN_REQUIRE_HTTPS=true
# Protected Administrator marker only. This does not grant any role.
ELIT_ADMIN_EMAIL=
# Administrator web reset links expire after 15 minutes by default.
ELIT_ADMIN_RESET_TTL=900
# Use a shared lock-capable store when the portal runs on multiple hosts.
ELIT_ADMIN_RESET_CACHE_STORE=file
# Target base URLs only; callback paths are supplied by application config.
SYSTEM_AIDID_URL=
SYSTEM_NUREEN_URL=
SYSTEM_SYIQIN_URL=
SYSTEM_IZZ_URL=
SYSTEM_TYA_URL=
SYSTEM_AIDID_ENABLED=true
SYSTEM_NUREEN_ENABLED=false
SYSTEM_SYIQIN_ENABLED=false
SYSTEM_IZZ_ENABLED=false
SYSTEM_TYA_ENABLED=false
# Use a different random secret for every target. Never reuse APP_KEY.
ALAMIN_LOGIN_CLIENT_SECRET_AIDID=
ALAMIN_LOGIN_CLIENT_SECRET_NUREEN=
ALAMIN_LOGIN_CLIENT_SECRET_SYIQIN=
ALAMIN_LOGIN_CLIENT_SECRET_IZZ=
ALAMIN_LOGIN_CLIENT_SECRET_TYA=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
